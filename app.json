{
  "expo": {
    "name": "Health Connect Workout Merger",
    "slug": "generic_health_connect_workout_merger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthconnect.workoutmerger"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1B1F"
      },
      "package": "com.healthconnect.workoutmerger",
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_CYCLING_PEDALING_CADENCE",
        "android.permission.health.WRITE_CYCLING_PEDALING_CADENCE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.health.WRITE_ELEVATION_GAINED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.WRITE_FLOORS_CLIMBED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.WRITE_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_POWER",
        "android.permission.health.WRITE_POWER",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.WRITE_RESTING_HEART_RATE",
        "android.permission.health.READ_SPEED",
        "android.permission.health.WRITE_SPEED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.READ_STEPS_CADENCE",
        "android.permission.health.WRITE_STEPS_CADENCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.WRITE_VO2_MAX",
        "android.permission.health.READ_WHEELCHAIR_PUSHES",
        "android.permission.health.WRITE_WHEELCHAIR_PUSHES"
      ]
    },
    "plugins": [
      "./plugins/withHealthConnectCustomization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1B1F"
        }
      ],
      [
        "react-native-health-connect",
        {
          "rationaleActivity": ".MainActivity"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "defaultLaunchURL": "http://localhost:8081",
          "android": {
            "defaultLaunchURL": "http://10.0.0.2:8081"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f0ff5f4-3dd5-4179-8fe1-8face4fcb005"
      }
    },
    "owner": "azumi0s-team"
  }
}
